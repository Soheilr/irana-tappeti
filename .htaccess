Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio canonico e rimozione di www/preview
  RewriteCond %{HTTP_HOST} !^tappeti-irana\.com$ [NC]
  RewriteRule ^ https://tappeti-irana.com%{REQUEST_URI} [R=301,L,NE]

  # Cartelle tecniche non pubbliche
  RewriteRule ^(?:\.git|\.github|scripts|deploy|docs)(?:/|$) - [R=404,L,NC]
</IfModule>

<IfModule mod_alias.c>
  RedirectMatch 301 ^/galleria-irana-tappeti(?:/.*)?$ /tappeti-persiani-milano/
  RedirectMatch 301 ^/blog(?:/.*)?$ /tappeti-persiani-milano/
  RedirectMatch 301 ^/manutenzione(?:/.*)?$ /
  RedirectMatch 301 ^/home-2(?:/.*)?$ /

  RedirectMatch 301 ^/category/tappeti-persiani(?:/.*)?$ /tappeti-persiani-milano/
  RedirectMatch 301 ^/category/irana-tappeti(?:/.*)?$ /
  RedirectMatch 301 ^/category/milano(?:/.*)?$ /
  RedirectMatch 301 ^/category/cinisello-balsamo(?:/.*)?$ /
  RedirectMatch 301 ^/category/iran(?:/.*)?$ /tappeti-persiani-milano/
  Redirect 301 /tappeti-persiani/shab-e-yalda/ /tappeti-persiani-milano/
  Redirect 301 /irana-tappeti/un-villaggio-di-natale/ /
  Redirect 301 /irana-tappeti/natale-e-cinema-elenco-classici/ /
  Redirect 301 /tappeti-persiani/capodanno-2016/ /tappeti-persiani-milano/
  Redirect 301 /irana-tappeti/epifania-feste-natalizie/ /
  Redirect 301 /tappeti-persiani/le-origini-del-tappeto-nain/ /tappeti-persiani-milano/
  Redirect 301 /tappeti-persiani/i-meravigliosi-tappeti-tabriz/ /tappeti-persiani-milano/
  Redirect 301 /tappeti-persiani/isfahan-una-citta-ricca-di-storia/ /tappeti-persiani-milano/
  Redirect 301 /irana-tappeti/san-valentino-in-salsa-persiana/ /
  Redirect 301 /tappeti-persiani/kilim-storia-e-provenienza/ /tappeti-persiani-milano/
  Redirect 301 /tappeti-persiani/giornata-del-gatto/ /riparazione-tappeti/
  Redirect 301 /tappeti-persiani/kashan-tappeti-del-deserto-persiano/ /tappeti-persiani-milano/
  Redirect 301 /tappeti-persiani/20-marzo-capodanno-persiano/ /tappeti-persiani-milano/
  Redirect 301 /irana-tappeti/21-marzo-1931-ricordando-alda-merini/ /
  Redirect 301 /milano/fuorisalone-2016-tappeti-moderni-di-alan-tamir/ /noleggio-tappeti-milano/
  Redirect 301 /irana-tappeti/tappeti-e-automobili-epoca-giornata-vintage/ /noleggio-tappeti-milano/
  Redirect 301 /irana-tappeti/lanterne-volanti-cinisello-balsamo/ /
  Redirect 301 /irana-tappeti/mercato-europeo-2016/ /
  Redirect 301 /irana-tappeti/dont-go-iran-ironia-racconta-bellezze-paese/ /
  Redirect 301 /irana-tappeti/santambrogio-la-festa-milano/ /
  Redirect 301 /cinisello-balsamo/artigianato-di-forte-dei-marmi-a-cinisello-balsamo/ /
  Redirect 301 /irana-tappeti/manifattura-dei-tappeti-moderni-in-india/ /tappeti-persiani-milano/
  Redirect 301 /uncategorized/il-tappeto-e-tornato-di-moda/ /tappeti-persiani-milano/


RedirectMatch 301 ^/new/lavaggio-tappeti/?$ /lavaggio-tappeti/

RedirectMatch 301 ^/tappeti-persiani/page/[0-9]+/?$ /tappeti-persiani-milano/

RedirectMatch 301 ^/irana-tappeti/page/[0-9]+/?$ /

RedirectMatch 301 ^/cinisello-balsamo/?$ /

RedirectMatch 301 ^/milano/?$ /

RedirectMatch 301 ^/gallery/tappeti-da-camera(?:/.*)?$ /tappeti-persiani-milano/

RedirectMatch 301 ^/sam_0589-nain-lana-e-seta-255-x-160cm-offerta-e/?$ /tappeti-persiani-milano/
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType application/manifest+json "access plus 1 month"
</IfModule>
